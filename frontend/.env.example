# Copy to .env.local to override. Both values are optional in development.

# Production: public origin of the API, including the version prefix.
# Leave unset in development: the app calls /api/v1 on its own origin and Vite proxies it to Django.
# VITE_API_URL=https://api.example.com/api/v1

# Development: where the Vite dev server forwards /api requests.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Copy to .env and fill in. Never commit .env.
# Every variable the settings read is listed here (a test enforces it).

# --- Which settings to run ------------------------------------------------------------------
# For local development. Without this variable, manage.py, wsgi and celery start in PRODUCTION mode,
# which refuses to run until SECRET_KEY, ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS and OAUTH_ENCRYPTION_KEY
# are real values. Never put the development value on a server.
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Core ---------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/microinfluencers
REDIS_URL=redis://localhost:6379/0

# --- Frontend -----------------------------------------------------------------------------
# Used for CORS and for links inside emails / the OAuth redirect. In production these must be https.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Deployment (production only) -----------------------------------------------------------
# Number of reverse proxies in front of the app; used to find the real client IP for rate limiting.
# 0 = no proxy (development). The production settings default to 1.
NUM_PROXIES=0
# Set to false only for a plain-HTTP smoke test of the production settings.
SECURE_SSL_REDIRECT=true
# HSTS tells browsers to use HTTPS only for this site. The two options below are hard to undo, so leave
# them off unless this domain will always be HTTPS-only. Use a small SECURE_HSTS_SECONDS (e.g. 300) first.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# --- Encryption of stored OAuth tokens ------------------------------------------------------------
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

# --- Google OAuth (YouTube, read-only). Create the app in Testing mode with test users. -----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/social/youtube/callback/

# Public YouTube video statistics for the brand analytics page. Optional: without it those figures
# are shown as not available. Create an API key restricted to the YouTube Data API v3.
YOUTUBE_API_KEY=

# --- Transactional email (any SMTP-compatible provider) ---------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
